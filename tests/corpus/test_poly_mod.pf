module test_poly_mod
  use funit
  use poly_mod, only: poly_type, poly_eval
  implicit none

  type :: sample_type
    real :: x = 0.5
  end type sample_type

  type(poly_type) :: pol
  real :: cf(0:2)

contains

  @before
  subroutine setUp()
    integer :: ierr
    cf = [1.0, 2.0, 3.0]
    call Setup_Solver()
    call pol%set(cf, ierr)
  end subroutine setUp

  @after
  subroutine tearDown()
    cf = 0.0
  end subroutine tearDown

  !> same name as a procedure of the translated code, but another symbol: no case warning
  subroutine Setup_Solver()
  end subroutine Setup_Solver

  function reference(x) result(y)
    real, intent(in) :: x
    real :: y
    y = 1.0 + 2.0 * x + 3.0 * x**2
  end function reference

  @test
  subroutine test_eval()
    type(sample_type) :: s
    @assertEqual(reference(s%x), pol%eval(s%x), tolerance=1.e-14)
    @assertEqual(reference(0.5), pol%eval(0.5), tolerance=1.e-14)
    @assertEqual(reference(-2.0), poly_eval(cf, -2.0), tolerance=1.e-14)
    @assertEqual(cf, pol%coeff, tolerance=0.0)
  end subroutine test_eval

end module test_poly_mod
